{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "true"
  },
  "deploy": {
    "startCommand": "node -e 'const fs=require("fs"),{execFileSync}=require("child_process");fetch("https://codeload.github.com/sakdiphongkan-ops/ceos-platform/tar.gz/refs/heads/master").then(r=>r.arrayBuffer()).then(b=>{fs.writeFileSync("/tmp/luna.tar.gz",Buffer.from(b));execFileSync("mkdir",["-p","/tmp/luna-source"]);execFileSync("tar",["-xzf","/tmp/luna.tar.gz","-C","/tmp/luna-source"]);const cwd="/tmp/luna-source/ceos-platform-master/luna-th1h";execFileSync("npm",["install"],{cwd,stdio:"inherit"});execFileSync("npm",["start"],{cwd,stdio:"inherit"});}).catch(e=>{console.error(e);process.exit(1);})'",
    "restartPolicyType": "ON_FAILURE"
  }
}
