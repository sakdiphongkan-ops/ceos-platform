LUNA_MODE=paper
MARKET_DATA_PROVIDER=settrade-gateway
LUNA_INITIAL_CAPITAL=1000000
LUNA_MAX_POSITION_PCT=0.075
LUNA_MAX_GROSS_EXPOSURE_PCT=0.50
LUNA_TIMEZONE=Asia/Bangkok
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SET_API_KEY=# legacy optional; use licensed gateway credentials
# SET_API_KEY=

# Fail-closed production defaults: never enable live trading without a licensed market-data provider and explicit review.
LUNA_PRICE_ONLY_FALLBACK=false
LUNA_REQUIRE_VERIFIED_BOOK=true
LUNA_PUBLIC_MARKETDATA_FALLBACK=false
LIVE_TRADING_ARMED=false

# Set this to the exact Git SHA approved for production after deploy verification.
# LUNA_EXPECTED_SOURCE_SHA=
